{
  "name": "techforge-tooling",
  "private": true,
  "version": "1.0.0",
  "description": "Dev-only tooling for TechForge. The site itself ships zero dependencies — nothing here is served to production.",
  "type": "module",
  "scripts": {
    "a11y": "node scripts/a11y-audit.mjs",
    "a11y:states": "node scripts/a11y-states.mjs",
    "build:index": "node tools/build-site-index.mjs",
    "build:og": "node tools/build-og-image.mjs",
    "build:readme": "node tools/sync-readme.mjs",
    "build:roles": "node tools/build-roles-hub.mjs",
    "check:anchors": "node scripts/check-anchors.mjs",
    "check:cache": "node scripts/check-cache-versions.mjs",
    "check:ci": "node scripts/check-ci-scripts.mjs",
    "check:entities": "node scripts/check-entities.mjs",
    "check:links": "node scripts/check-links.mjs",
    "check:navbar": "node tools/sync-navbar.mjs --check",
    "check:og": "node tools/build-og-image.mjs --check",
    "check:readme": "node tools/sync-readme.mjs --check",
    "check:sections": "node scripts/check-sections.mjs",
    "check:sidebars": "node scripts/check-sidebars.mjs",
    "test:validator": "node scripts/test-validate-graphs.mjs",
    "validate:graphs": "node scripts/validate-graphs.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.1",
    "playwright": "^1.48.0"
  }
}
